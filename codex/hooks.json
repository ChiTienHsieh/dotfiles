{
  "description": "Global Codex CLI stop checkpoint and worktree tracking.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.codex/hooks/stop_dispatcher.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.codex/hooks/stop_dispatcher.py\"",
            "timeout": 30,
            "statusMessage": "Checking thread status"
          }
        ]
      }
    ]
  }
}
