{
  "description": "Global Codex CLI dirty-worktree checkpoint and tmux worker tracking.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/bin/track_tmux_workers.py\"",
            "timeout": 5,
            "statusMessage": "Tracking tmux workers"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.codex/hooks/stop_dirty_worktree.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/bin/track_tmux_workers.py\"",
            "timeout": 5,
            "statusMessage": "Checking tmux worker cleanup"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.codex/hooks/stop_dirty_worktree.py\"",
            "timeout": 30,
            "statusMessage": "Checking worktrees"
          }
        ]
      }
    ]
  }
}
