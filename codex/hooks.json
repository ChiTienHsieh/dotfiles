{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/dotfiles/codex/hooks/stop_dirty_worktree.py\"",
            "timeout": 10,
            "statusMessage": "Tracking git worktree"
          }
        ]
      }
    ]
  }
}
