# =============================================================================
# .secrets/index.sh - API keys and sensitive credentials
# =============================================================================
# IMPORTANT: This file should NEVER be committed to git!
# Copy this template to ~/.secrets/index.sh and fill in your actual values.
#
# install.sh creates the directory with mode 700 and this file with mode 600.
# =============================================================================

# OpenAI
export OPENAI_API_KEY=""

# Anthropic：別在這裡全域 export。
# 設了之後，終端機開的 `claude -p` 會改用這把 key，改走 API 計費、不走訂閱；
# 其他用 Anthropic SDK 的程式也會讀到。
# 要用的專案自己設（direnv 或專案的 env 檔）。
# export ANTHROPIC_API_KEY=""

# Google Gemini
export GEMINI_API_KEY=""

# Context7
export CONTEXT7_API_KEY=""

# Custom paths (use $HOME for portability)
export obsidian_path="$HOME/ObsidianVault"
