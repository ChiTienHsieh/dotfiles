#!/usr/bin/env sh
# Global pre-commit dispatcher.
#
# This hook runs for every repo through core.hooksPath. It enforces the
# user-wide Markdown zh-tw default and the per-file token budget, then chains
# a repo-local .git/hooks/pre-commit if one exists.

set -eu

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for CHECKER in "$HOOK_DIR/lib/check-md-zh-tw-ratio.mjs" "$HOOK_DIR/lib/check-token-budget.mjs"; do
    [ -x "$CHECKER" ] || continue
    if command -v node >/dev/null 2>&1; then
        node "$CHECKER"
    else
        echo "⚠️  node not found; skipping $(basename "$CHECKER")"
    fi
done

# Repo hooks live in the common git dir. Linked worktrees have a per-worktree
# git dir under .git/worktrees/<name>, so absolute-git-dir alone misses hooks.
GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
LEGACY_HOOK=""
if [ -n "$GIT_COMMON_DIR" ]; then
    LEGACY_HOOK="$GIT_COMMON_DIR/hooks/pre-commit"
fi
if [ -n "$LEGACY_HOOK" ] && [ -x "$LEGACY_HOOK" ]; then
    # Avoid self-recursion when a repo points .git/hooks/pre-commit back here.
    if [ "$LEGACY_HOOK" != "$0" ] && [ "$LEGACY_HOOK" != "$HOOK_DIR/pre-commit" ]; then
        "$LEGACY_HOOK"
    fi
fi
