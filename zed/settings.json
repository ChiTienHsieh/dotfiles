{
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": true,
  "project_panel": { "dock": "left" },
  "agent": {
    "dock": "right",
    "expand_terminal_card": false,
    "expand_edit_card": false
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "low",
        "fast": false
      },
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark Soft"
  }
}
