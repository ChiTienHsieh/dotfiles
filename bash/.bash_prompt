#!/usr/bin/env bash
# =============================================================================
# .bash_prompt - Terminal prompt configuration
# =============================================================================
# 跟 zsh/.zshrc 第 9 節同一套：使用者名 + 主機名 + 目錄，同一組 256 色。
# 主機名依 hostname 決定，所以 ssh 到別台（例如 VM）不會再冒出 MacAir。

# User display name + color (fallback: \u in white)
case $USER in
    sprin)  _u='\[\e[38;5;117m\]Sprin\[\e[m\]' ;;
    shroom) _u='\[\e[38;5;183m\]Shroom\[\e[m\]' ;;
    *)      _u='\[\e[97m\]\u\[\e[m\]' ;;
esac

# Host display name (always blue; only the label is remapped)
case $(hostname -s) in
    Sprin-MBA*) _h='\[\e[38;5;111m\]MacAir\[\e[m\]' ;;
    *)          _h='\[\e[38;5;111m\]\h\[\e[m\]' ;;
esac

PS1="${_u} ${_h} \[\e[38;5;180m\]\W\[\e[m\] \$ "
unset _u _h
export PS1

# -----------------------------------------------------------------------------
# ls colors
# -----------------------------------------------------------------------------
if [[ "$OSTYPE" == darwin* ]]; then
    export CLICOLOR=1
    export LSCOLORS=ExFxBxDxCxegedabagacad
else
    export LS_COLORS='di=1;34:ln=1;35:so=1;31:pi=1;33:ex=1;32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43'
fi
