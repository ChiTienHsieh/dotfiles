# Ghostty 設定 — Dracula (gu-log 配色)
# 文件：https://ghostty.org/docs/config/reference

# ── 字型 ──────────────────────────────────────
font-family = Maple Mono NF
font-size = 14
font-thicken = true
font-feature = cv01

# CJK 備用字型 — Noto Sans CJK TC 顯示正體中文
font-codepoint-map = U+3000-U+303F,U+3100-U+312F,U+31A0-U+31BF=Noto Sans CJK TC
font-codepoint-map = U+3400-U+4DBF,U+4E00-U+9FFF=Noto Sans CJK TC
font-codepoint-map = U+F900-U+FAFF,U+FE30-U+FE4F=Noto Sans CJK TC
font-codepoint-map = U+FF00-U+FFEF=Noto Sans CJK TC
font-codepoint-map = U+20000-U+2A6DF,U+2A700-U+2B73F=Noto Sans CJK TC

# ── 主題 ──────────────────────────────────────
# 內建 Dracula 配色，前景色用 gu-log 的柔和版本
theme = Dracula
foreground = #cecdda
selection-background = #44475a
selection-foreground = #cecdda
cursor-color = #ff79c6

# ── 視窗 ──────────────────────────────────────
macos-titlebar-style = tabs
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.92
background-blur = 20

# ── 游標 ──────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── macOS ─────────────────────────────────────
# 左 Option = Alt（給 vim/zsh 快捷鍵），右 Option = macOS 輸入法
macos-option-as-alt = left
macos-auto-secure-input = true

# ── 滑鼠與剪貼簿 ─────────────────────────────
copy-on-select = clipboard
mouse-hide-while-typing = true
right-click-action = paste

# ── Shell 整合 ───────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title

# 第一個 tab 維持純 zsh。之後開的 tab、視窗、分割都啟動新 tmux session。
# 清除繼承的 TMUX 環境變數以避免巢狀。
initial-command = /bin/zsh
command = direct:/usr/bin/env -u TMUX /opt/homebrew/bin/tmux new-session

# ── QoL ──────────────────────────────────────
confirm-close-surface = true
scrollback-limit = 10000000
link-url = true

# ── 按鍵映射 ─────────────────────────────────
# 讓 Shift+Enter 送出與 Enter 不同的序列，Codex/Claude TUI 才能區分。
# Ghostty 可綁 CSI 序列；tmux 透過 csi-u 轉送。
keybind = shift+enter=csi:13;2u
