#!/usr/bin/env zsh
# =============================================================================
# pre-commit hook - secret scan + jargon check + run tests before commit
# =============================================================================
# Skip with: git commit --no-verify

DOTFILES_DIR="$(git rev-parse --show-toplevel)"

# -----------------------------------------------------------------------------
# 1. Secret scan (public repo guard)
# -----------------------------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner --redact 2>/dev/null; then
        echo "❌ gitleaks found potential secrets in staged changes, commit aborted"
        echo "   Review the findings above or use 'git commit --no-verify' to skip"
        exit 1
    fi
else
    # Lightweight fallback: scan only ADDED lines in the staged diff
    ADDED_LINES=$(git diff --cached -U0 | grep '^+' | grep -v '^+++')
    SECRET_PATTERN='BEGIN [A-Z ]*PRIVATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}'
    if echo "$ADDED_LINES" | grep -qE "$SECRET_PATTERN"; then
        echo "❌ Potential secret detected in staged changes, commit aborted:"
        echo "$ADDED_LINES" | grep -nE "$SECRET_PATTERN" | head -5
        echo "   If this is a false positive, use 'git commit --no-verify'"
        exit 1
    fi
fi

# Warn (non-blocking) on machine-bound absolute paths in added lines
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -q '/Users/sprin'; then
    echo "⚠️  Staged additions contain absolute /Users/sprin paths — OK for examples,"
    echo "   but seeds/configs should stay portable (use \$HOME or ~)."
fi

# -----------------------------------------------------------------------------
# 2. Jargon scan (comment lines in staged diffs + added lines in staged *.md)
# -----------------------------------------------------------------------------
ALLOWLIST="$DOTFILES_DIR/hooks/jargon-allowlist.yml"

# Added lines in staged *.md files (shared by sections 2 and 2b).
# level-up/learning/ records are written by the skill itself and legitimately
# mention rejected words when documenting them, so they are skipped.
MD_ADDED_LINES=$(git diff --cached --name-only --diff-filter=AM -z \
    | grep -zE '\.md$' \
    | grep -zvE '^skills/shared/level-up/learning/' \
    | xargs -0r git diff --cached -U0 -- 2>/dev/null \
    | grep '^+' | grep -v '^+++' | sed 's/^\+//')

if [[ -f "$ALLOWLIST" ]]; then
    # Parse flat YAML lists without external parser
    _parse_section() {
        local file=$1 section=$2
        sed -n "/^${section}:/,/^[a-z]/p" "$file" \
            | grep '^  - ' \
            | sed 's/^  - //' \
            | sed 's/|.*//'
    }

    ALLOW_WORDS=$(_parse_section "$ALLOWLIST" "allow")
    REJECT_ENTRIES=$(sed -n '/^reject:/,/^[a-z]/p' "$ALLOWLIST" | grep '^  - ' | sed 's/^  - //')

    # Extract comment lines from staged diff (added lines only)
    COMMENT_LINES=$(git diff --cached -U0 \
        | grep '^+' | grep -v '^+++' \
        | grep -E '^\+\s*(#|//|<!--|%)\s' \
        | sed 's/^\+//')

    # Reject-listed words are blocked in comments and in .md prose;
    # the unknown-abbreviation warning stays comment-only (prose has legit caps).
    # Parenthetical groups are stripped first: the accepted format is
    # 「中文 (english)」, so the English word inside parentheses must pass.
    REJECT_SCAN_LINES=$(printf '%s\n' "$COMMENT_LINES" "$MD_ADDED_LINES" \
        | sed -E 's/\([^)]*\)//g; s/（[^）]*）//g')

    if [[ -n "$COMMENT_LINES" || -n "$MD_ADDED_LINES" ]]; then
        JARGON_BLOCKED=()
        JARGON_WARNED=()

        # Check each reject-listed word
        while IFS='|' read -r word format; do
            [[ -z "$word" ]] && continue
            if echo "$REJECT_SCAN_LINES" | grep -qiw "$word"; then
                JARGON_BLOCKED+=("$word → $format")
            fi
        done <<< "$REJECT_ENTRIES"

        # Find unknown all-caps abbreviations (≥2 chars) not in allow list
        UNKNOWN_ABBREVS=$(echo "$COMMENT_LINES" \
            | grep -oE '\b[A-Z][A-Z0-9]{1,}(;[A-Z]+)?\b' \
            | sort -u)

        while IFS= read -r abbrev; do
            [[ -z "$abbrev" ]] && continue
            # Skip if in allow list (case-insensitive match)
            if echo "$ALLOW_WORDS" | grep -qix "$abbrev"; then
                continue
            fi
            # Skip common non-jargon patterns
            if [[ "$abbrev" =~ ^[A-F0-9]+$ ]]; then
                continue  # hex values
            fi
            JARGON_WARNED+=("$abbrev")
        done <<< "$UNKNOWN_ABBREVS"

        if [[ ${#JARGON_BLOCKED[@]} -gt 0 ]]; then
            echo "❌ Jargon rejected — 使用者不認識以下詞彙，請用中文寫法："
            for entry in "${JARGON_BLOCKED[@]}"; do
                echo "   $entry"
            done
            echo "   如果使用者確認已認識，把該詞從 reject 移到 allow："
            echo "   $ALLOWLIST"
            exit 1
        fi

        if [[ ${#JARGON_WARNED[@]} -gt 0 ]]; then
            echo "⚠️  Unknown abbreviations in comments (non-blocking):"
            for abbrev in "${JARGON_WARNED[@]}"; do
                echo "   $abbrev — not in allowlist, check with user"
            done
            echo "   Add to allow/reject in: $ALLOWLIST"
        fi
    fi
fi

# -----------------------------------------------------------------------------
# 2b. Taiwan-terms scan (added lines in staged *.md files)
# -----------------------------------------------------------------------------
if [[ -f "$ALLOWLIST" ]]; then
    ZH_TW_ENTRIES=$(sed -n '/^zh_tw_terms:/,/^[a-z]/p' "$ALLOWLIST" | grep '^  - ' | sed 's/^  - //')

    if [[ -n "$ZH_TW_ENTRIES" && -n "$MD_ADDED_LINES" ]]; then
        ZH_TW_BLOCKED=()

        while IFS='|' read -r word replacement; do
            [[ -z "$word" ]] && continue
            if echo "$MD_ADDED_LINES" | grep -q "$word"; then
                ZH_TW_BLOCKED+=("$word → $replacement")
            fi
        done <<< "$ZH_TW_ENTRIES"

        if [[ ${#ZH_TW_BLOCKED[@]} -gt 0 ]]; then
            echo "❌ 台灣用語檢查失敗 — staged .md 新增行含以下寫法，請改用右邊："
            for entry in "${ZH_TW_BLOCKED[@]}"; do
                echo "   $entry"
            done
            echo "   詞表（zh_tw_terms）：$ALLOWLIST"
            exit 1
        fi
    fi
fi

# -----------------------------------------------------------------------------
# 3. Alias tests (only when shell config files are staged)
# -----------------------------------------------------------------------------
TEST_SCRIPT="$DOTFILES_DIR/tests/test_aliases.sh"

if [[ ! -x "$TEST_SCRIPT" ]]; then
    echo "⚠️  Test script not found, skipping..."
    exit 0
fi

STAGED_FILES=$(git diff --cached --name-only)
SHELL_FILES_PATTERN="bash/|\.aliases|\.bashrc|\.zshrc|\.bash_profile"

if echo "$STAGED_FILES" | grep -qE "$SHELL_FILES_PATTERN"; then
    echo "🧪 Running dotfiles tests..."
    echo ""

    if "$TEST_SCRIPT"; then
        echo ""
        echo "✅ Tests passed, proceeding with commit"
        exit 0
    else
        echo ""
        echo "❌ Tests failed, commit aborted"
        echo "   Fix the issues or use 'git commit --no-verify' to skip"
        exit 1
    fi
else
    # No shell config changes, skip tests
    exit 0
fi
