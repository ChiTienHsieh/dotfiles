#!/usr/bin/env zsh
# =============================================================================
# pre-commit hook - secret scan + run tests before commit
# =============================================================================
# Skip with: git commit --no-verify

DOTFILES_DIR="$(git rev-parse --show-toplevel)"

# -----------------------------------------------------------------------------
# 1. Secret scan (public repo guard)
# -----------------------------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner --redact 2>/dev/null; then
        echo "❌ gitleaks found potential secrets in staged changes, commit aborted"
        echo "   Review the findings above or use 'git commit --no-verify' to skip"
        exit 1
    fi
else
    # Lightweight fallback: scan only ADDED lines in the staged diff
    ADDED_LINES=$(git diff --cached -U0 | grep '^+' | grep -v '^+++')
    SECRET_PATTERN='BEGIN [A-Z ]*PRIVATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}'
    if echo "$ADDED_LINES" | grep -qE "$SECRET_PATTERN"; then
        echo "❌ Potential secret detected in staged changes, commit aborted:"
        echo "$ADDED_LINES" | grep -nE "$SECRET_PATTERN" | head -5
        echo "   If this is a false positive, use 'git commit --no-verify'"
        exit 1
    fi
fi

# Warn (non-blocking) on machine-bound absolute paths in added lines
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -q '/Users/sprin'; then
    echo "⚠️  Staged additions contain absolute /Users/sprin paths — OK for examples,"
    echo "   but seeds/configs should stay portable (use \$HOME or ~)."
fi

# -----------------------------------------------------------------------------
# 2. Targeted tests
# -----------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only)
SHELL_FILES_PATTERN="bash/|\.aliases|\.bashrc|\.zshrc|\.bash_profile"
HEADLESS_FILES_PATTERN='install\.sh|claude/settings\.json|claude/scripts/install-headless-codex\.py|codex/notes/codex-cli\.md|skills/shared/(headless-agents|tmux-orchestration)/|tests/test_headless_agents(_live|_claude)?\.sh|tests/fixtures/headless-boundary\.schema\.json'

if echo "$STAGED_FILES" | grep -qE "$HEADLESS_FILES_PATTERN"; then
    echo "🧪 Running headless-agents tests..."
    echo ""
    if ! "$DOTFILES_DIR/tests/test_headless_agents.sh"; then
        echo ""
        echo "❌ Headless-agents tests failed, commit aborted"
        exit 1
    fi
fi

if echo "$STAGED_FILES" | grep -qE "$SHELL_FILES_PATTERN"; then
    TEST_SCRIPT="$DOTFILES_DIR/tests/test_aliases.sh"
    if [[ ! -x "$TEST_SCRIPT" ]]; then
        echo "⚠️  Alias test script not found, skipping..."
        exit 0
    fi
    echo "🧪 Running alias tests..."
    echo ""

    if "$TEST_SCRIPT"; then
        echo ""
        echo "✅ Tests passed, proceeding with commit"
        exit 0
    else
        echo ""
        echo "❌ Tests failed, commit aborted"
        echo "   Fix the issues or use 'git commit --no-verify' to skip"
        exit 1
    fi
fi

exit 0
